# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
Game3D-ASM/[Ll]ibrary/
Game3D-ASM/[Tt]emp/
Game3D-ASM/[Oo]bj/
Game3D-ASM/[Bb]uild/
Game3D-ASM/[Bb]uilds/
Game3D-ASM/[Ll]ogs/
Game3D-ASM/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
Game3D-ASM/[Mm]emoryCaptures/

# Recordings can get excessive in size
Game3D-ASM/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
Game3D-ASM/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
*.ExportedObj/
*.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
Game3D-ASM/sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
Game3D-ASM/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
Game3D-ASM/[Aa]ssets/[Ss]treamingAssets/aa.meta
Game3D-ASM/[Aa]ssets/[Ss]treamingAssets/aa/*
Game3D-ASM/Assets/TextMesh Pro/Examples & Extras/Resources/Fonts & Materials/Bangers SDF.asset
Game3D-ASM/Assets/TextMesh Pro/Examples & Extras/Resources/Fonts & Materials/Bangers SDF.asset
/Game3D-ASM/Assets/TextMesh Pro/Examples & Extras/Resources/Fonts & Materials
Game3D-ASM/Assets/Resources/TriForge Assets/_BiRP Content - Fantasy Worlds - Old Forest DEMO.unitypackage.meta
Game3D-ASM/Assets/Resources/TriForge Assets/_URP Content - Fantasy Worlds - Old Forest DEMO.unitypackage.meta
